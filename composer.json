{
    "name": "somnambulist/collection",
    "description": "Collection implementation with no dependencies.",
    "keywords": [
        "domain",
        "collection",
        "set"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Dave Redfern",
            "email": "info@somnambulist.tech"
        }
    ],
    "type": "library",
    "require": {
        "php": ">=8.4",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4",
        "symfony/phpunit-bridge": "^7.0|^8.0",
        "symfony/var-dumper": "^7.0|^8.0",
        "victorjonsson/markdowndocs": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "Somnambulist\\Components\\Collection\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Somnambulist\\Components\\Collection\\Tests\\": "tests/"
        }
    }
}
